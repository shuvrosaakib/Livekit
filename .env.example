# =========================
# SHUVRO AI ENGLISH TUTOR
# Render environment variables
# =========================

# LiveKit Cloud (or your self-hosted LiveKit server)
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Google Gemini API key — keep this ONLY in Render Environment Variables.
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY

# Recommended SHUVRO model for current LiveKit AgentSession features.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# HTTP server
PORT=10000
